# Copy to .env (never commit it). Only the variables for your profile are needed.
CODE_RAG_PROFILE=cloud

# --- cloud profile ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# --- webhooks (set at least one) ---
CODE_RAG_WEBHOOKS__GITHUB_SECRET=
CODE_RAG_WEBHOOKS__GITLAB_SECRET=

# --- tracing (optional): none | langfuse | otel ---
CODE_RAG_TRACING__BACKEND=none
CODE_RAG_TRACING__LANGFUSE_PUBLIC_KEY=
CODE_RAG_TRACING__LANGFUSE_SECRET_KEY=
CODE_RAG_TRACING__LANGFUSE_HOST=https://cloud.langfuse.com
# For otel: standard OTEL_EXPORTER_OTLP_ENDPOINT / OTEL_SERVICE_NAME variables apply.
